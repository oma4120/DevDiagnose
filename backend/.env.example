# MongoDB connection string (required - all data is stored in MongoDB Atlas).
# The backend refuses to start if this is unset or unreachable; there is no local fallback.
MONGODB_URI=
DB_NAME=DevDiagnose

# Secret used to sign login JWTs. Required - the API will not boot without it.
# It must be at least 16 characters and must NOT be the placeholder value below.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_random_secret

# First-run administrator. Used only when the members collection is empty, which
# is the only way to obtain the first Admin: there is no self-registration and
# invitations require an existing Admin. Both variables must be set together.
# The password must satisfy the invite policy: 8+ characters with an uppercase
# letter, a number and a symbol. Leave empty once you have a real account.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Admin

# Demo dataset. Off by default so a fresh database never comes up with accounts
# whose password is published in this repository. Set to true only for local
# development or a demo deployment, and reseed with:
#   python -m app.reseed
SEED_DEMO_DATA=false

# Guardrails for the "Analyze with AI" endpoint: a per-user cooldown and a cap on
# how many analyses are retained per bug, to bound cost and document growth.
ANALYZE_COOLDOWN_SECONDS=20
MAX_ANALYSES_PER_BUG=10

# Groq API key for the "Analyze with AI" endpoint. Without it, analysis returns a clear 503.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated list of allowed origins for CORS.
#
# Not needed on Vercel: the frontend and backend are served from one domain and
# /api is rewritten to the backend, so browser requests are same-origin. This
# only matters when the API is called from a different origin, such as the local
# Vite dev server on :5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public base URL used to build email invitation links. On Vercel this must be
# your production domain, or invitation emails will point at localhost.
APP_URL=http://localhost:5173

# How long an invitation stays valid.
INVITE_TTL_HOURS=72

# SMTP settings for the "invite by email" flow. Leave SMTP_HOST empty to
# log invitations instead of sending (handy for local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@devdiagnose.app
