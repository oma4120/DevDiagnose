# MongoDB connection string (Atlas or local). Backend falls back to in-memory seed data if this is unset or unreachable.
MONGODB_URI=
DB_NAME=DevDiagnose

# Groq API key for the "Analyze with AI" endpoint. Without it, analysis returns a clear 503.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Secret used to sign login JWTs. Change to a long random value outside a dev environment.
JWT_SECRET=dev-secret-change-me

# Comma-separated list of allowed origins for CORS (frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public base URL used to build email invitation links.
APP_URL=http://localhost:5173

# SMTP settings for the "invite by email" flow. Leave SMTP_HOST empty to
# log invitations instead of sending (handy for local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@devdiagnose.app